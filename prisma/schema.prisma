generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id @default(uuid()) @db.Uuid
  firstName         String?              @map("first_name") @db.VarChar(50)
  lastName          String?              @map("last_name") @db.VarChar(50)
  username          String               @db.VarChar(50)
  tag               Int?
  email             String               @unique @db.VarChar(100)
  passwordHash      String               @map("password_hash") @db.VarChar(255)
  avatarUrl         String?              @map("avatar_url")
  bio               String?
  profileVisibility ProfileVisibility    @default(PRIVATE) @map("profile_visibility")
  role              UserRole             @default(USER)
  isActive          Boolean              @default(true) @map("is_active")
  lastLogin         DateTime?            @map("last_login")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  connectionsRecv   Connection[]         @relation("Receiver")
  connectionsSent   Connection[]         @relation("Requester")
  documentsMember   DocumentUser[]
  documentsCreated  Document[]           @relation("DocumentCreator")
  eventReminders    EventReminder[]
  eventsMember      EventUser[]
  eventsCreated     Event[]              @relation("EventCreator")
  files             File[]               @relation("FileUploader")
  groupsMember      GroupUser[]
  groupsOwned       Group[]              @relation("GroupOwner")
  notebooksReceived NotebookShare[]      @relation("SharedWith")
  notebooksShared   NotebookShare[]      @relation("SharedBy")
  notebooksMember   NotebookUser[]
  notebooksCreated  Notebook[]           @relation("NotebookCreator")
  notebooksOwned    Notebook[]           @relation("NotebookOwner")
  notifications     Notification[]
  projectsMember    ProjectUser[]
  projectsCreated   Project[]            @relation("ProjectCreator")
  projectsOwned     Project[]            @relation("ProjectOwner")
  taskComments      TaskComment[]
  tasksManaged      TaskUser[]           @relation("AssignedBy")
  tasksAssigned     TaskUser[]
  tasksCreated      Task[]               @relation("TaskCreator")
  teamsMember       TeamUser[]
  teamsOwned        Team[]               @relation("TeamOwner")
  sessionComments   WorkSessionComment[]
  workSessions      WorkSession[]

  @@unique([username, tag])
  @@map("users")
}

model Connection {
  id          String           @id @default(uuid()) @db.Uuid
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  acceptedAt  DateTime?        @map("accepted_at")
  requesterId String           @map("requester_id") @db.Uuid
  receiverId  String           @map("receiver_id") @db.Uuid
  receiver    User             @relation("Receiver", fields: [receiverId], references: [id])
  requester   User             @relation("Requester", fields: [requesterId], references: [id])

  @@unique([requesterId, receiverId])
  @@map("connections")
}

model Group {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @db.VarChar(200)
  description String?
  isPublic    Boolean     @default(false) @map("is_public")
  createdAt   DateTime    @default(now()) @map("created_at")
  ownerId     String      @map("owner_id") @db.Uuid
  members     GroupUser[]
  owner       User        @relation("GroupOwner", fields: [ownerId], references: [id])
  projects    Project[]

  @@map("groups")
}

model GroupUser {
  id       String   @id @default(uuid()) @db.Uuid
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_users")
}

model Team {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(200)
  description String?
  isPublic    Boolean    @default(false) @map("is_public")
  createdAt   DateTime   @default(now()) @map("created_at")
  ownerId     String     @map("owner_id") @db.Uuid
  members     TeamUser[]
  owner       User       @relation("TeamOwner", fields: [ownerId], references: [id])

  @@map("teams")
}

model TeamUser {
  id       String   @id @default(uuid()) @db.Uuid
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_users")
}

model Project {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @db.VarChar(100)
  description  String?
  icon         String?            @db.VarChar(100)
  color        String?            @db.VarChar(50)
  isArchived   Boolean            @default(false) @map("is_archived")
  isPublic     Boolean            @default(false) @map("is_public")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  ownerId      String             @map("owner_id") @db.Uuid
  creatorId    String             @map("creator_id") @db.Uuid
  groupId      String?            @map("group_id") @db.Uuid
  documents    Document[]
  events       Event[]
  files        File[]
  kanbanBoards KanbanBoard[]
  folders      NotebookFolder[]
  notebooks    NotebookRelation[]
  users        ProjectUser[]
  creator      User               @relation("ProjectCreator", fields: [creatorId], references: [id])
  group        Group?             @relation(fields: [groupId], references: [id])
  owner        User               @relation("ProjectOwner", fields: [ownerId], references: [id])
  tags         Tag[]
  tasks        Task[]
  workSessions WorkSession[]

  @@map("projects")
}

model ProjectUser {
  id        String      @id @default(uuid()) @db.Uuid
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now()) @map("joined_at")
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_users")
}

model Task {
  id           String        @id @default(uuid()) @db.Uuid
  title        String        @db.VarChar(100)
  description  String?
  status       TaskStatus    @default(TODO)
  priority     TaskPriority  @default(MEDIUM)
  dueDate      DateTime?     @map("due_date")
  endDate      DateTime?     @map("end_date")
  position     Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  projectId    String        @map("project_id") @db.Uuid
  creatorId    String        @map("created_by") @db.Uuid
  columnId     String?       @map("kanban_column_id") @db.Uuid
  subtasks     Subtask[]
  comments     TaskComment[]
  tags         TaskTag[]
  assignees    TaskUser[]
  creator      User          @relation("TaskCreator", fields: [creatorId], references: [id])
  column       KanbanColumn? @relation(fields: [columnId], references: [id])
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workSessions WorkSession[]

  @@map("tasks")
}

model Subtask {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(100)
  isCompleted Boolean  @default(false) @map("is_completed")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  taskId      String   @map("task_id") @db.Uuid
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("subtasks")
}

model TaskUser {
  id         String   @id @default(uuid()) @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String   @map("assigned_by") @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assigner   User     @relation("AssignedBy", fields: [assignedBy], references: [id])
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_users")
}

model KanbanBoard {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(50)
  description String?
  icon        String?        @db.VarChar(100)
  position    Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  creatorId   String         @map("created_by") @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns     KanbanColumn[]

  @@map("kanban_boards")
}

model KanbanColumn {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @db.VarChar(50)
  color     String?     @db.VarChar(50)
  position  Int         @default(0)
  limitTask Int?        @map("limit_task")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  boardId   String      @map("board_id") @db.Uuid
  board     KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@map("kanban_columns")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("task_comments")
}

model Notebook {
  id          String             @id @default(uuid()) @db.Uuid
  title       String             @db.VarChar(100)
  description String?
  icon        String?            @db.VarChar(100)
  color       String?            @db.VarChar(50)
  isPublic    Boolean            @default(false) @map("is_public")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  ownerId     String             @map("owner_id") @db.Uuid
  creatorId   String             @map("created_by") @db.Uuid
  folderId    String?            @map("folder_id") @db.Uuid
  documents   Document[]
  projects    NotebookRelation[]
  shares      NotebookShare[]
  users       NotebookUser[]
  creator     User               @relation("NotebookCreator", fields: [creatorId], references: [id])
  folder      NotebookFolder?    @relation(fields: [folderId], references: [id])
  owner       User               @relation("NotebookOwner", fields: [ownerId], references: [id])

  @@map("notebooks")
}

model NotebookUser {
  id         String     @id @default(uuid()) @db.Uuid
  role       AccessRole @default(READER)
  invitedBy  String?    @map("invited_by") @db.Uuid
  joinedAt   DateTime   @default(now()) @map("joined_at")
  notebookId String     @map("notebook_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  notebook   Notebook   @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notebook_users")
}

model NotebookShare {
  id         String   @id @default(uuid()) @db.Uuid
  notebookId String   @map("notebook_id") @db.Uuid
  sharedBy   String   @map("shared_by") @db.Uuid
  shareWith  String   @map("share_with") @db.Uuid
  sharedAt   DateTime @default(now()) @map("shared_at")
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  receiver   User     @relation("SharedWith", fields: [shareWith], references: [id])
  sender     User     @relation("SharedBy", fields: [sharedBy], references: [id])

  @@map("notebook_shares")
}

model NotebookFolder {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(100)
  parentId  String?    @map("parent_id") @db.Uuid
  projectId String?    @map("project_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  project   Project?   @relation(fields: [projectId], references: [id])
  notebooks Notebook[]

  @@map("notebook_folders")
}

model NotebookRelation {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  notebookId String   @map("notebook_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  notebook   Notebook @relation(fields: [notebookId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id])

  @@unique([notebookId, projectId])
  @@map("notebook_relations")
}

model Document {
  id         String         @id @default(uuid()) @db.Uuid
  title      String         @db.VarChar(100)
  content    Json?
  icon       String?        @db.VarChar(100)
  coverImage String?        @map("cover_image")
  position   Int            @default(0)
  isPublic   Boolean        @default(false) @map("is_public")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  creatorId  String         @map("created_by") @db.Uuid
  notebookId String?        @map("notebook_id") @db.Uuid
  projectId  String?        @map("project_id") @db.Uuid
  users      DocumentUser[]
  creator    User           @relation("DocumentCreator", fields: [creatorId], references: [id])
  notebook   Notebook?      @relation(fields: [notebookId], references: [id])
  project    Project?       @relation(fields: [projectId], references: [id])

  @@map("documents")
}

model DocumentUser {
  id         String     @id @default(uuid()) @db.Uuid
  role       AccessRole @default(READER)
  invitedBy  String?    @map("invited_by") @db.Uuid
  joinedAt   DateTime   @default(now()) @map("joined_at")
  documentId String     @map("document_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("document_users")
}

model Event {
  id          String          @id @default(uuid()) @db.Uuid
  title       String          @db.VarChar(100)
  description String?
  startDate   DateTime        @map("start_date")
  endDate     DateTime        @map("end_date")
  location    String?         @db.VarChar(255)
  isAllDay    Boolean         @default(false) @map("is_all_day")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  projectId   String          @map("project_id") @db.Uuid
  creatorId   String          @map("creator_id") @db.Uuid
  reminders   EventReminder[]
  users       EventUser[]
  creator     User            @relation("EventCreator", fields: [creatorId], references: [id])
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("events")
}

model EventUser {
  id             String         @id @default(uuid()) @db.Uuid
  responseStatus ResponseStatus @default(PENDING) @map("response_status")
  eventId        String         @map("event_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_users")
}

model EventReminder {
  id                  String   @id @default(uuid()) @db.Uuid
  remindBeforeMinutes Int      @map("remind_before_minutes")
  createdAt           DateTime @default(now()) @map("created_at")
  eventId             String   @map("event_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("event_reminders")
}

model File {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(255)
  filePath   String   @map("file_path")
  fileType   String   @map("file_type") @db.VarChar(50)
  fileSize   Int      @map("file_size")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  projectId  String   @map("project_id") @db.Uuid
  uploaderId String   @map("uploader_id") @db.Uuid
  project    Project  @relation(fields: [projectId], references: [id])
  uploader   User     @relation("FileUploader", fields: [uploaderId], references: [id])

  @@map("files")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  type        NotificationType
  title       String
  content     String
  referenceId String?          @map("reference_id") @db.Uuid
  refType     ReferenceType?   @map("reference_type")
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")
  userId      String           @map("user_id") @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model WorkSession {
  id          String               @id @default(uuid()) @db.Uuid
  startTime   DateTime             @default(now()) @map("start_time")
  endTime     DateTime?            @map("end_time")
  description String?
  createdAt   DateTime             @default(now()) @map("created_at")
  userId      String               @map("user_id") @db.Uuid
  taskId      String?              @map("task_id") @db.Uuid
  projectId   String?              @map("project_id") @db.Uuid
  comments    WorkSessionComment[]
  project     Project?             @relation(fields: [projectId], references: [id])
  task        Task?                @relation(fields: [taskId], references: [id])
  user        User                 @relation(fields: [userId], references: [id])

  @@map("work_sessions")
}

model WorkSessionComment {
  id        String      @id @default(uuid()) @db.Uuid
  content   String
  createdAt DateTime    @default(now()) @map("created_at")
  sessionId String      @map("session_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  session   WorkSession @relation(fields: [sessionId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@map("work_session_comments")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(50)
  color     String    @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  projectId String    @map("project_id") @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id])
  tasks     TaskTag[]

  @@map("tags")
}

model TaskTag {
  taskId String @map("task_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

enum UserRole {
  ADMIN
  USER
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  connectionRequest
  taskAssignment
  taskAssigned
  taskDue
  eventReminder
  projectInvite
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TeamRole {
  ADMIN
  MEMBER
}

enum AccessRole {
  OWNER
  EDITOR
  READER
}

enum ReferenceType {
  TASK
  EVENT
  PROJECT
  CONNECTION
}

enum ResponseStatus {
  PENDING
  ACCEPTED
  REJECTED
}
